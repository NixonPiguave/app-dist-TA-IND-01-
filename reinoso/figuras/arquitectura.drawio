<mxfile host="app.diagrams.net"><diagram name="Arquitectura Redis Cluster" id="arq1"><mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1100" pageHeight="650"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n3" value="Red Docker 172.30.0.0/24: 6 contenedores redis:7.2 (cluster-enabled yes, appendonly yes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f8fb;strokeColor=#7a8aa0;dashed=1;verticalAlign=top;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="230" y="40" width="750" height="420" as="geometry"/></mxCell><mxCell id="n4" value="Cliente&lt;br&gt;redis-cli -c&lt;br&gt;(PowerShell, Windows)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="15" y="250" width="170" height="90" as="geometry"/></mxCell><mxCell id="n5" value="redis1 (maestro)&lt;br&gt;172.30.0.11:6379&lt;br&gt;slots 0-5460" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ecff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="260" y="120" width="200" height="90" as="geometry"/></mxCell><mxCell id="n6" value="redis2 (maestro)&lt;br&gt;172.30.0.12:6379&lt;br&gt;slots 5461-10922" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ecff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="510" y="120" width="200" height="90" as="geometry"/></mxCell><mxCell id="n7" value="redis3 (maestro)&lt;br&gt;172.30.0.13:6379&lt;br&gt;slots 10923-16383" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ecff;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="760" y="120" width="200" height="90" as="geometry"/></mxCell><mxCell id="n8" value="redis5&lt;br&gt;réplica de redis1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4f5e4;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="260" y="370" width="200" height="60" as="geometry"/></mxCell><mxCell id="n9" value="redis6&lt;br&gt;réplica de redis2" style="rounded=1;whiteSpace=wrap;html=1;fil